# Add a Bandsintown app ID to load real upcoming events and map markers.
NEXT_PUBLIC_BANDSINTOWN_APP_ID=

# Sanity project settings. The project ID below matches the configured Studio.
NEXT_PUBLIC_SANITY_PROJECT_ID=wcx01w97
NEXT_PUBLIC_SANITY_DATASET=production

# Shared Postgres connection used for the lyrics studio and cross-instance API rate limits.
POSTGRES_URL=

# Private admin token required by the studio lyrics API.
ADMIN_API_TOKEN=

# Contact form email delivery. Use a sender address verified with Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional YouTube Data API credentials. Keep the API key server-side and restrict it in Google Cloud.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Optional Spotify Web API credentials. Keep both values server-side; never use NEXT_PUBLIC_ here.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_ARTIST_ID=1GM9nGfwFjiwZtgIWO3sh2
SPOTIFY_MARKET=ZA

# Optional analytics IDs. Leave blank to disable each tracker.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
